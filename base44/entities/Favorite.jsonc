{
  "name": "Favorite",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "gameId": {
      "type": "string"
    },
    "notifyIncident": {
      "type": "boolean",
      "default": true
    },
    "notifyRecovery": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "gameId"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}