{
  "name": "UserReport",
  "type": "object",
  "properties": {
    "gameId": {
      "type": "string"
    },
    "gameName": {
      "type": "string"
    },
    "storeName": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "enumColors": [
        "yellow",
        "green",
        "gray"
      ],
      "default": "pending"
    },
    "reviewedBy": {
      "type": "string"
    },
    "reviewNote": {
      "type": "string"
    }
  },
  "required": [
    "description"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}