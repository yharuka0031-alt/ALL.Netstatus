{
  "name": "NotificationSettings",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "incidentEnabled": {
      "type": "boolean",
      "default": true
    },
    "recoveryEnabled": {
      "type": "boolean",
      "default": true
    },
    "maintenanceEnabled": {
      "type": "boolean",
      "default": true
    },
    "noticeEnabled": {
      "type": "boolean",
      "default": false
    },
    "selectedGameIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pushEnabled": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}