{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "lastVisitedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastSeenAnnouncementIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readNotificationIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settings": {
      "type": "object"
    }
  },
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}